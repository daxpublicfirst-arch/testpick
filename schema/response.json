{"$id":"https://github.com/daxpublicfirst-arch/testpick/schema/response.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"The JSON object written to stdout (and to <out>/selection.json) by `testpick select`.","properties":{"fail_safe":{"enum":["all","none"],"type":"string"},"ok":{"const":true,"type":"boolean"},"reason":{"description":"Human-readable reason for the selection.","type":"string"},"selected":{"description":"Tests that reach the change, sorted and deduplicated.","items":{"type":"string"},"type":"array"},"tool":{"const":"testpick","type":"string"},"unmapped":{"description":"Changed files that no test covers, sorted.","items":{"type":"string"},"type":"array"},"version":{"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$","type":"string"}},"required":["ok","tool","version","selected","unmapped","reason","fail_safe"],"title":"testpick select response","type":"object"}