{"$id":"https://github.com/daxpublicfirst-arch/testpick/schema/error.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"The single JSON object printed to stdout on failure. The process exits non-zero (2 usage/input error, 3 tool failure).","properties":{"error":{"additionalProperties":false,"properties":{"blocked":{"description":"What went wrong.","type":"string"},"code":{"description":"Machine-readable error code.","enum":["NO_DIFF","BAD_DIFF","NO_COVERAGE","BAD_COVERAGE","BAD_REQUEST","INPUT_TOO_LARGE","IO_ERROR","NO_FIXTURES","TOOL_ERROR","USAGE"],"type":"string"},"fix":{"description":"What to do about it.","type":"string"},"if_that_fails":{"description":"What to try if the fix does not work.","type":"string"}},"required":["code","blocked","fix","if_that_fails"],"type":"object"},"ok":{"const":false,"type":"boolean"}},"required":["ok","error"],"title":"testpick failure object","type":"object"}